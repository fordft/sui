{
  "name": "sui-desktop",
  "version": "0.12.9",
  "private": true,
  "description": "SUI Desktop for macOS and Linux",
  "main": "main.js",
  "scripts": {
    "dev": "cargo build --manifest-path ../Cargo.toml --bin sui && node node_modules/electron/install.js && electron .",
    "test": "node --test test/*.test.js",
    "dist:mac": "cargo build --manifest-path ../Cargo.toml --release --bin sui && node node_modules/electron/install.js && electron-builder --mac dmg zip",
    "dist:linux": "cargo build --manifest-path ../Cargo.toml --release --bin sui && node node_modules/electron/install.js && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "dev.sui.desktop",
    "productName": "SUI Desktop",
    "files": ["main.js", "preload.js", "bridge.js", "providers.js", "workspaces.js", "update.js", "index.html", "boot.js", "markdown.js", "pet.js", "ui.js", "review.js", "recovery.js", "app.js", "styles.css", "pet.css", "fonts/*"],
    "extraResources": [{"from": "../target/release/sui", "to": "sui"}, {"from": "../install.sh", "to": "install.sh"}],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "artifactName": "SUI.Desktop-${version}-${arch}.${ext}",
      "identity": "-",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "linux": {"category": "Development", "target": ["AppImage"]},
    "directories": {"output": "dist"}
  },
  "devDependencies": {
    "electron": "44.7.1",
    "electron-builder": "26.15.3"
  }
}
